# Corpus smoke test: does the regulatory material actually RETRIEVE, not just download?
# Run with evo.ragframework against a tenant that has the packs loaded (or, pre-pack-system,
# a folder source over $RAG_DOCS/_TEXT/<corpus>). Every 'contains' regex is a fact that is
# verifiably in the corpus text; the rubric covers what a regex cannot decide.
# Linking is deliberately left to the rubric: whether a folder-sourced document yields a
# citation URL is itself one of the things this run should reveal.
{"id": "loto-periodic-inspection", "category": "cfr-29", "issue": "evo.ai#191", "question": "How often does OSHA require a periodic inspection of energy control procedures under the lockout/tagout standard?", "expect": {"answered": true, "contains": ["at least annually|annual|12 months|once a year"]}, "rubric": "States the inspection is at least annual, cites 29 CFR 1910.147(c)(6), and does not invent a shorter interval.", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "hazcom-sds-sections", "category": "cfr-29", "issue": "evo.ai#191", "question": "How many sections must a Safety Data Sheet have under the Hazard Communication standard?", "expect": {"answered": true, "contains": ["16|sixteen"]}, "rubric": "Answers 16 sections and ties it to 29 CFR 1910.1200(g).", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "bbp-hepb-vaccination-window", "category": "cfr-29", "issue": "evo.ai#191", "question": "Under the bloodborne pathogens standard, how soon after assignment must an employer make the hepatitis B vaccine available to an exposed employee?", "expect": {"answered": true, "contains": ["10 working days|ten working days"]}, "rubric": "Says within 10 working days of initial assignment, per 1910.1030(f)(2).", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "respirator-medical-eval-before-fit", "category": "cfr-29", "issue": "evo.ai#191", "question": "Does an employee need a medical evaluation before being fit tested for a respirator?", "expect": {"answered": true, "contains": ["medical evaluation"], "not_contains": ["no medical evaluation is required"]}, "rubric": "Yes - medical evaluation precedes fit testing under 1910.134(e). A hedge that it is optional is a fail.", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "construction-fall-protection-trigger", "category": "cfr-29", "issue": "evo.ai#191", "question": "At what height does fall protection become required on a construction site under OSHA rules?", "expect": {"answered": true, "contains": ["6 feet|six feet|1\\.8 m"]}, "rubric": "6 feet, citing 29 CFR 1926.501. Bonus if it notes general industry differs (4 feet).", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "recordkeeping-fatality-report-window", "category": "cfr-29", "issue": "evo.ai#191", "question": "How quickly must an employer report a work-related fatality to OSHA?", "expect": {"answered": true, "contains": ["8 hours|eight hours"]}, "rubric": "Within 8 hours, per 29 CFR 1904.39. Should not confuse it with the 24-hour window for hospitalizations/amputations.", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "psm-threshold-quantities", "category": "cfr-29", "issue": "evo.ai#191", "question": "Where does the Process Safety Management standard list the chemicals and threshold quantities that make a process covered?", "expect": {"answered": true, "contains": ["Appendix A|threshold quantit"]}, "rubric": "Points to 1910.119 Appendix A as the list of highly hazardous chemicals with threshold quantities.", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "interp-letters-exist-for-loto", "category": "osha-interpretations", "issue": "evo.ai#191", "question": "Has OSHA issued interpretation letters about whether a periodic lockout/tagout inspection can be done by the same person who performs the procedure?", "expect": {"answered": true, "no_blanket_absence": true}, "rubric": "Draws on an OSHA interpretation letter (not just the rule text), reflects OSHA's position that the inspector must be an authorized employee other than the one using the procedure, and cites the letter. Claiming no letters exist is a fail - 232 letters cite 1910.147.", "tags": ["corpus", "smoke", "osha", "interpretations"]}
{"id": "interp-archived-flagged", "category": "osha-interpretations", "issue": "evo.ai#191", "question": "What did OSHA say in the 1970s about whether 1910.36 automatically requires two means of egress?", "expect": {"answered": true}, "rubric": "Finds the 1976 letter and, critically, signals that it is an ARCHIVED interpretation that may no longer represent OSHA policy. Presenting a 1976 position as current with no caveat is a fail - this is the corpus's main misuse mode.", "tags": ["corpus", "smoke", "osha", "interpretations", "archived"]}
{"id": "directive-enforcement-how", "category": "osha-directives", "issue": "evo.ai#191", "question": "What does OSHA's enforcement directive tell inspectors to check when evaluating a bloodborne pathogens exposure control plan?", "expect": {"answered": true, "contains": ["exposure control plan"]}, "rubric": "Answers from the CPL enforcement directive (inspector procedures), not only from the standard text, and names the directive.", "tags": ["corpus", "smoke", "osha", "directives"]}
{"id": "hazmat-table-location", "category": "cfr-49", "issue": "evo.ai#191", "question": "Which section of 49 CFR contains the Hazardous Materials Table with proper shipping names and UN numbers?", "expect": {"answered": true, "contains": ["172\\.101"]}, "rubric": "49 CFR 172.101.", "tags": ["corpus", "smoke", "dot-hazmat", "cfr-49"]}
{"id": "hazmat-recurrent-training", "category": "cfr-49", "issue": "evo.ai#191", "question": "How often must hazmat employees receive recurrent training under DOT rules?", "expect": {"answered": true, "contains": ["three years|3 years|36 months"]}, "rubric": "At least once every three years, per 49 CFR 172.704(c)(2). Bonus: notes this is DOT training, distinct from OSHA HazCom training.", "tags": ["corpus", "smoke", "dot-hazmat", "cfr-49"]}
{"id": "epcra-tier2-deadline", "category": "epa", "issue": "evo.ai#191", "question": "When is the annual EPCRA Tier II hazardous chemical inventory report due?", "expect": {"answered": true, "contains": ["March 1"]}, "rubric": "March 1 each year, from EPA's EPCRA material.", "tags": ["corpus", "smoke", "epa", "epcra"]}
{"id": "rmp-program-levels", "category": "epa", "issue": "evo.ai#191", "question": "What are the program levels under EPA's Risk Management Program rule and what determines which one applies?", "expect": {"answered": true, "contains": ["Program 1|Program 2|Program 3|program level"]}, "rubric": "Names Programs 1, 2 and 3 and explains eligibility turns on offsite impact and process complexity/industry, from EPA RMP guidance.", "tags": ["corpus", "smoke", "epa", "rmp"]}
{"id": "lead-rrp-pre1978", "category": "epa", "issue": "evo.ai#191", "question": "Which housing does EPA's lead Renovation, Repair and Painting rule apply to?", "expect": {"answered": true, "contains": ["1978"]}, "rubric": "Housing built before 1978 (and child-occupied facilities), from EPA lead material.", "tags": ["corpus", "smoke", "epa", "lead"]}
{"id": "nfpa-space-heater-clearance", "category": "nfpa-public", "issue": "evo.ai#191", "question": "How far should a portable space heater be kept from anything that can burn?", "expect": {"answered": true, "contains": ["3 feet|three feet|1 meter|1 metre"]}, "rubric": "Three feet, from NFPA's heating safety tip sheet, attributed to NFPA.", "tags": ["corpus", "smoke", "nfpa-public"]}
{"id": "asbestos-construction-class-i", "category": "cfr-29", "issue": "evo.ai#191", "question": "What is Class I asbestos work under OSHA's construction asbestos standard?", "expect": {"answered": true, "contains": ["Class I"], "no_blanket_absence": true}, "rubric": "Defines Class I as removal of thermal system insulation and surfacing ACM/PACM, per 1926.1101(b).", "tags": ["corpus", "smoke", "osha", "cfr-29"]}
{"id": "control-off-topic-gated", "category": "control", "issue": "evo.ai#191", "question": "What is the capital of France?", "expect": {"gated": true}, "rubric": "The relevance gate refuses; the corpus must not be used to bluff an answer.", "tags": ["corpus", "smoke", "control", "adversarial"]}
